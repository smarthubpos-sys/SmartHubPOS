@@ -18,6 +18,16 @@ describe("report core", () => {
     expect(s.counts).toEqual({ entries: 4, invoices: 1, voids: 0, returns: 1 });
     expect(s.daily.find((d) => d.date === "2026-10-14")).toMatchObject({ sales: 90000, cogs: 54000, expenses: 20000, profit: 16000 });
   });
+  it("stock adjustments (shrinkage / gain) are not counted as expenses", () => {
+    const adj: JEntry = { entryDate: "2026-10-14", sourceType: "stock_adjustment", lines: [
+      { code: "5200", name: "Stock shrinkage expense", type: "expense", debit: 7000, credit: 0 },
+      { code: "1200", name: "Inventory", type: "asset", debit: 0, credit: 7000 },
+    ] };
+    const base = summarize(build(entries));
+    const withAdj = summarize(build([...entries, adj]));
+    expect(withAdj.totalExpenses).toBe(base.totalExpenses);
+    expect(withAdj.netProfit).toBe(base.netProfit);
+  });
   it("adding chunks gives the same answer as one pass", () => {
     const merged = mergeRows(mergeRows(new Map<string, Row>(), build(entries.slice(0, 2))), build(entries.slice(2)));
     expect(summarize(accRows(merged))).toEqual(summarize(build(entries)));
diff --git a/convex/reportCore.ts b/convex/reportCore.ts
index 697fd74..17d6450 100644
--- a/convex/reportCore.ts
+++ b/convex/reportCore.ts
@@ -57,6 +57,9 @@ export function entryRows(e: JEntry, acc: Acc = new Map()): Acc {
   // Selling Point (waiter) money: the journal is dated the day the money was RECEIVED, but a sale belongs to the day it was SOLD.
   // So for these entries only the MONEY (CASH / LIPA / BANK) is read here; their sales and cost of goods come from the orders (see waiterSalesOf).
   const moneyOnly = isWaiterMoneyEntry(e.sourceType);
+  // Stock adjustments / stock-take corrections only fix the quantity (and the Inventory value in the ledger): they are NOT a business expense, so their
+  // expense lines (5100 gain / 5200 shrinkage) never reach the report.
+  const stockAdjustment = e.sourceType === "stock_adjustment";
   if (e.sourceType === "sale") row("stat", "invoices", "", 1);
   if (e.sourceType === "sale_void") row("stat", "voids", "", 1);
   if (e.sourceType === "sale_return") row("stat", "returns", "", 1);
@@ -64,6 +67,7 @@ export function entryRows(e: JEntry, acc: Acc = new Map()): Acc {
   for (const l of e.lines) {
     const debit = l.debit || 0, credit = l.credit || 0;
     if (moneyOnly && !isMoneyLine(l)) continue;
+    if (stockAdjustment && l.type === "expense") continue;
     if (l.type === "revenue") {
       const amount = credit - debit;
       row("rev", l.code, l.name, amount);
