# Convex deployment URL (replace with the real URL from your Convex deployment)
VITE_CONVEX_URL=https://YOUR-DEPLOYMENT.convex.cloud

# Configure on the Convex deployment with:
# npx convex env set SUPER_ADMIN_USERNAME your-initial-admin-username
# Password login is handled by Convex Auth; no OIDC provider is required.

# Convex environment variable (NOT a Vite/frontend secret): set on each Convex deployment.
# Must exactly match the browser origin used for biometric/WebAuthn operations, e.g. https://pos.example.com
# npx convex env set APP_ORIGIN https://your-actual-app-origin.example

# QZ Tray signing configuration (public certificate URL + server-side signature endpoint).
# The private signing key MUST stay on the server and must never be a VITE_* variable.
# Certificate endpoint returns the public X.509 certificate as text/plain.
# Signature endpoint accepts POST application/x-www-form-urlencoded with `request=<toSign>`
# and returns the SHA512/RSA signature as base64 text/plain.
VITE_QZ_CERTIFICATE_URL=
VITE_QZ_SIGNATURE_URL=
