+  sheet.mergeCells(1, 1, 1, Math.max(1, cols.length));
+  sheet.getRow(1).font = { bold: true, size: 16, color: { argb: "FF1E3A5F" } };
+  sheet.addRow([`${tr("Imeandaliwa")}: ${new Date().toLocaleString()}`]);
+  sheet.addRow([]);
+  sheet.addRow(cols.map((c) => tr(c)));
+  for (const row of rows) sheet.addRow(cols.map((c) => row[c] ?? ""));
+  if (sumCols.length) {
+    const total = sheet.addRow(cols.map((c, i) => sumCols.includes(c) || sumCols.includes(tr(c))
+      ? round2(rows.reduce((n, r) => n + num(r[c]), 0)) : i === 0 ? tr("JUMLA") : ""));
+    total.font = { bold: true };
