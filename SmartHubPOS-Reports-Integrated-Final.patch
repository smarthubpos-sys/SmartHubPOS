+  cols.forEach((key, index) => {
+    const lengths = [tr(key).length, ...rows.map((row) => String(row[key] ?? "").length)];
+    sheet.getColumn(index + 1).width = Math.min(40, Math.max(12, ...lengths.map((n) => n + 2)));
